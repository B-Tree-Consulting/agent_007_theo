{
  "info": {
    "name": "AyDEO agent-007-theo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Refresh auth tokens (test mode)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/**",
                  " * BFA Host Postman auth pre-request (test + production).",
                  " *",
                  " * Environment:",
                  " *   auth_mode=test|production   (default: test)",
                  " *   auth_auto_mint=true|false   (test mode only; default true)",
                  " *",
                  " * Test mode (AUTH_TEST_MODE=true on server):",
                  " *   Auto-mints HS256 mock management_token, de_token, capability_token.",
                  " *",
                  " * Production mode (AUTH_TEST_MODE=false on server):",
                  " *   Never mints. Paste Entra JWTs into access_token and/or management_token.",
                  " *   Runtime invoke also needs de_token + capability_token from platform mint.",
                  " *",
                  " */",
                  "",
                  "function authMode() {",
                  "    const mode = String(pm.environment.get(\"auth_mode\") || \"test\").toLowerCase();",
                  "    return mode === \"production\" ? \"production\" : \"test\";",
                  "}",
                  "",
                  "function nonBlank(value) {",
                  "    return typeof value === \"string\" && value.trim().length > 0;",
                  "}",
                  "",
                  "function syncProductionBearerTokens() {",
                  "    if (authMode() !== \"production\") {",
                  "        return;",
                  "    }",
                  "    const access = pm.environment.get(\"access_token\");",
                  "    const mgmt = pm.environment.get(\"management_token\");",
                  "    if (nonBlank(access) && !nonBlank(mgmt)) {",
                  "        pm.environment.set(\"management_token\", access.trim());",
                  "    } else if (nonBlank(mgmt) && !nonBlank(access)) {",
                  "        pm.environment.set(\"access_token\", mgmt.trim());",
                  "    }",
                  "}",
                  "",
                  "const AUTH_TEST_SECRET = pm.collectionVariables.get(\"auth_test_secret\")",
                  "    || pm.environment.get(\"auth_test_secret\")",
                  "    || \"test-secret-key-do-not-use-in-production\";",
                  "",
                  "function base64urlWordArray(wordArray) {",
                  "    return CryptoJS.enc.Base64.stringify(wordArray)",
                  "        .replace(/=+$/, \"\")",
                  "        .replace(/\\+/g, \"-\")",
                  "        .replace(/\\//g, \"_\");",
                  "}",
                  "",
                  "function base64urlString(value) {",
                  "    return base64urlWordArray(CryptoJS.enc.Utf8.parse(value));",
                  "}",
                  "",
                  "function signHs256Jwt(payload) {",
                  "    const header = base64urlString(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" }));",
                  "    const body = base64urlString(JSON.stringify(payload));",
                  "    const data = `${header}.${body}`;",
                  "    const signature = base64urlWordArray(",
                  "        CryptoJS.HmacSHA256(data, AUTH_TEST_SECRET)",
                  "    );",
                  "    return `${data}.${signature}`;",
                  "}",
                  "",
                  "function mintEntraToken({ subject, roles, scope }) {",
                  "    const now = Math.floor(Date.now() / 1000);",
                  "    return signHs256Jwt({",
                  "        sub: subject,",
                  "        iat: now,",
                  "        exp: now + 3600,",
                  "        roles,",
                  "        scope,",
                  "    });",
                  "}",
                  "",
                  "function mintManagementToken() {",
                  "    return mintEntraToken({",
                  "        subject: \"config-admin@test.com\",",
                  "        roles: [\"AyDEO-Config-Admin\"],",
                  "        scope: \"*\",",
                  "    });",
                  "}",
                  "",
                  "function mintDeToken(deId) {",
                  "    return mintEntraToken({",
                  "        subject: deId,",
                  "        roles: [\"AyDEO-DE\"],",
                  "        scope: \"cases:read cases:write\",",
                  "    });",
                  "}",
                  "",
                  "function mintCapabilityToken(deId, tools, bfaServiceSlug) {",
                  "    const now = Math.floor(Date.now() / 1000);",
                  "    return signHs256Jwt({",
                  "        sub: deId,",
                  "        de_id: deId,",
                  "        iss: \"aydeo-test\",",
                  "        aud: \"aydeo-bfa\",",
                  "        iat: now,",
                  "        exp: now + 3600,",
                  "        bfa_service_id: pm.collectionVariables.get(\"bfa_service_id\")",
                  "            || \"00000000-0000-4000-8000-000000000001\",",
                  "        bfa_service_slug: bfaServiceSlug,",
                  "        tools,",
                  "    });",
                  "}",
                  "",
                  "function catalogToolsForCapability(catalogBody) {",
                  "    const tools = catalogBody.tools || [];",
                  "    return tools",
                  "        .filter((entry) => entry.name)",
                  "        .map((entry) => ({",
                  "            tool_name: String(entry.name),",
                  "            version: String(entry.version),",
                  "            risk: String(entry.risk || \"low\"),",
                  "        }))",
                  "        .filter((entry) => entry.version);",
                  "}",
                  "",
                  "function shouldMintTokens() {",
                  "    if (authMode() === \"production\") {",
                  "        return false;",
                  "    }",
                  "    const autoMint = pm.environment.get(\"auth_auto_mint\");",
                  "    if (autoMint === \"false\" || autoMint === false) {",
                  "        return false;",
                  "    }",
                  "    const force = pm.environment.get(\"auth_force_refresh\");",
                  "    if (force === \"true\" || force === true) {",
                  "        pm.environment.unset(\"auth_force_refresh\");",
                  "        return true;",
                  "    }",
                  "    const mgmt = pm.environment.get(\"management_token\");",
                  "    const de = pm.environment.get(\"de_token\");",
                  "    const cap = pm.environment.get(\"capability_token\");",
                  "    return !mgmt || !de || !cap;",
                  "}",
                  "",
                  "async function mintAuthTestModeTokens() {",
                  "    const baseUrl = pm.environment.get(\"base_url\") || pm.collectionVariables.get(\"base_url\");",
                  "    const deId = pm.environment.get(\"bfa_test_de_id\")",
                  "        || pm.collectionVariables.get(\"bfa_test_de_id\")",
                  "        || \"00000000-0000-4000-8000-0000000000de\";",
                  "    const bfaServiceSlug = pm.environment.get(\"bfa_service_slug\")",
                  "        || pm.collectionVariables.get(\"bfa_service_slug\")",
                  "        || \"agent-007-theo\";",
                  "",
                  "    const managementToken = mintManagementToken();",
                  "    pm.environment.set(\"management_token\", managementToken);",
                  "    pm.environment.set(\"access_token\", managementToken);",
                  "",
                  "    const catalogResponse = await pm.sendRequest({",
                  "        url: `${baseUrl}/api/v1/bfa/catalog`,",
                  "        method: \"GET\",",
                  "        header: { Authorization: `Bearer ${managementToken}` },",
                  "    });",
                  "",
                  "    if (catalogResponse.code !== 200) {",
                  "        throw new Error(",
                  "            `Management catalog failed (${catalogResponse.code}): ${catalogResponse.text()}. `",
                  "            + \"Test mode: ensure AUTH_TEST_MODE=true on the server and auth_mode=test.\"",
                  "        );",
                  "    }",
                  "",
                  "    const catalogBody = catalogResponse.json();",
                  "    const tools = catalogToolsForCapability(catalogBody);",
                  "    if (tools.length === 0) {",
                  "        throw new Error(\"Management catalog returned no grantable tools.\");",
                  "    }",
                  "",
                  "    pm.environment.set(\"de_token\", mintDeToken(deId));",
                  "    pm.environment.set(",
                  "        \"capability_token\",",
                  "        mintCapabilityToken(deId, tools, bfaServiceSlug)",
                  "    );",
                  "    pm.environment.set(\"auth_tokens_minted_at\", new Date().toISOString());",
                  "}",
                  "",
                  "syncProductionBearerTokens();",
                  "if (shouldMintTokens()) {",
                  "    await mintAuthTestModeTokens();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authMode = String(pm.environment.get('auth_mode') || 'test').toLowerCase();",
                  "if (authMode === 'production') {",
                  "    pm.test('skipped mint checks in production mode', function () { pm.expect(true).to.eql(true); });",
                  "} else {",
                  "    pm.test('management_token set', function () {",
                  "        pm.expect(pm.environment.get('management_token')).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('de_token set', function () {",
                  "        pm.expect(pm.environment.get('de_token')).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.test('capability_token set', function () {",
                  "        pm.expect(pm.environment.get('capability_token')).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Test mode only: mints mock JWTs into management_token, de_token, capability_token. Requires AUTH_TEST_MODE=true on the server and auth_mode=test."
          }
        },
        {
          "name": "Validate production management token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ready returns 200 with pasted Entra token', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('catalog returns 200 with same management token', async function () {",
                  "    const baseUrl = pm.environment.get('base_url');",
                  "    const token = pm.environment.get('management_token');",
                  "    pm.expect(token, 'Set access_token or management_token first').to.be.a('string').and.not.empty;",
                  "    const catalogResponse = await pm.sendRequest({",
                  "        url: `${baseUrl}/api/v1/bfa/catalog`,",
                  "        method: 'GET',",
                  "        header: { Authorization: `Bearer ${token}` },",
                  "    });",
                  "    pm.expect(catalogResponse.code).to.eql(200);",
                  "    const body = catalogResponse.json();",
                  "    pm.expect(body.tools).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{management_token}}"
              }
            ],
            "url": "{{base_url}}/health/ready",
            "description": "Production: set auth_mode=production, paste your Entra JWT into access_token (or management_token), then send. Verifies the same token works for /health/ready and /api/v1/bfa/catalog."
          }
        }
      ],

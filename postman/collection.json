    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Public liveness \u2014 no auth and no pre-request script (matches platform BFA health check)."
          }
        },
        {

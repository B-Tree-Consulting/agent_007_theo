# =============================================================================
# AyDEO agent-007-theo — environment template
# =============================================================================
# Copy to the repository root:
#   cp backend/.env.example .env
# Fill values locally. This file stays empty in git.

# =============================================================================
# PostgreSQL (docker-compose + backend)
# =============================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=

# =============================================================================
# Database (backend)
# =============================================================================
DATABASE_URL=

# =============================================================================
# Authentication — Entra ID (backend)
# =============================================================================
AUTH_ENABLED=
AUTH_TEST_MODE=
AUTH_PROVIDER=

IDP_ISSUER=
IDP_AUDIENCE=
IDP_JWKS_URI=
APP_ID=

JWKS_CACHE_TTL_SECONDS=
JWKS_FETCH_TIMEOUT_SECONDS=
JWT_LEEWAY_SECONDS=

# =============================================================================
# AyDEO platform service URLs
# =============================================================================
AYDEO_UM_BASE_URL=
UM_HTTP_TIMEOUT_SECONDS=

AYDEO_CHAT_BASE_URL=
CHAT_HTTP_TIMEOUT_SECONDS=
AYDEO_CHAT_INTERNAL_TOKEN=

AYDEO_CONFIG_BASE_URL=

DRIS_CAPABILITY_JWKS_URI=
DRIS_CAPABILITY_ISSUER=

AYDEO_PLATFORM_APPROVAL_PROOF_JWKS_URL=
AYDEO_PLATFORM_APPROVAL_PROOF_ISSUER=

AYDEO_CMS_BASE_URL=
AYDEO_PLATFORM_INTERNAL_SERVICE_TOKEN=

AYDEO_AUDIT_URL=
OUTBOX_INTERNAL_SERVICE_TOKEN=
AYDEO_AUDIT_SPOOL_PATH=

# =============================================================================
# BFA host identity
# =============================================================================
BFA_SERVICE_SLUG=
SERVICE_VERSION=
BFA_TEST_DE_ID=
BFA_CONFIRM_TEST_MODE=
BFA_INVOKE_DIAGNOSTIC_MODE=

# =============================================================================
# Server (backend)
# =============================================================================
HOST=
PORT=
LOG_LEVEL=

AYDEO_MIGRATE_ON_START=

# =============================================================================
# DB Setup
# =============================================================================
# trader-sync-trading-kv-secrets.sh reads this section for the demo database.
# Set DEMO_DATABASE_URL to the Azure Postgres URL. Local DATABASE_URL above is
# not in this section, so a compose host is not uploaded by mistake.
# DEMO_DATABASE_URL=

# =============================================================================
# Trading App Configuration
# =============================================================================
# Optional. Empty values are skipped. Stored as trader-app-<env-var> in
# kv-aydeo-demo-weu. The existing demo app already has these secrets.
# T212_API_KEY=
# T212_API_SECRET=
# THEO_WHITELIST=
# THEO_WHITELIST_PATH=
# THEO_SYMBOL_OVERRIDES=

# =============================================================================
# Docker build (compose interpolates from repo-root .env — not read by the API)
# =============================================================================
GITHUB_TOKEN=

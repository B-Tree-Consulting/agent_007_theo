# Demo Azure Container Apps — names and non-secret defaults only.
# Local docker-compose uses backend/.env.example, not this file.
# Operator steps: README.md "Demo operator flow".
#
# trader-apply.sh writes these onto the existing Container App trader-app.
# The image is built from this repository. The script reads Azure; it does not
# source .env.demo. Copy to gitignored .env.demo at the repo root only as a
# local note. Do not put connection strings, tokens, or client secrets here.

# --- non-secret defaults set by trader-apply.sh ---
BFA_SERVICE_SLUG=agent-007-theo
AYDEO_MIGRATE_ON_START=1
AUTH_TEST_MODE=false
BFA_CONFIRM_TEST_MODE=false
# URLs use the Container Apps default domain of cae-aydeo-demo-weu.
# AYDEO_CHAT_BASE_URL=https://aydeo-chat.<defaultDomain>
# AYDEO_CMS_BASE_URL=https://aydeo-be.<defaultDomain>
# AYDEO_UM_BASE_URL=https://aydeo-be.<defaultDomain>
# DRIS_CAPABILITY_JWKS_URI=https://aydeo-be.<defaultDomain>/.well-known/bfa-capability-jwks.json
DRIS_CAPABILITY_ISSUER=aydeo-be.dris
# AYDEO_PLATFORM_APPROVAL_PROOF_JWKS_URL=https://aydeo-be.<defaultDomain>/.well-known/approval-proof-jwks.json
AYDEO_PLATFORM_APPROVAL_PROOF_ISSUER=aydeo-be.approval-proof
# IDP_AUDIENCE is kept when already set; otherwise api://<APP_ID> from the live app.
# APP_ID and IDP_ISSUER must already be set on the Container App. Apply does not overwrite them.

# --- secret values live in Key Vault kv-aydeo-demo-weu (names only) ---
# DATABASE_URL
#   Key Vault: trader-app-database-url
#   Container App secret: trader-app-database-url
# T212_API_KEY, T212_API_SECRET, THEO_WHITELIST, THEO_WHITELIST_PATH, THEO_SYMBOL_OVERRIDES
#   Key Vault and Container App secret: trader-app-<env-var-in-kebab>
# AYDEO_CHAT_INTERNAL_TOKEN
#   Key Vault: aydeo-chat-internal-service-token
#   Container App secret: chat-internal-service-token
# AYDEO_PLATFORM_INTERNAL_SERVICE_TOKEN
#   Key Vault: aydeo-platform-internal-service-token
#   Container App secret: platform-internal-service-token
